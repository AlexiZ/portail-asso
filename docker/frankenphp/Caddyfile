{
	frankenphp
	# admin API stays on localhost:2019 inside the container only (not published) - the base image's healthcheck needs it
}

{$SERVER_NAME:localhost} {
	log {
		output stderr
	}

	root * /app/public
	encode zstd br gzip

	# Never execute or render as a document anything uploaded by users
	@uploadsBlocked path_regexp (?i)^/uploads/.*\.(php\d?|phtml|phar|html?|svgz?|xml|js)$
	respond @uploadsBlocked 403
	php_server
}
