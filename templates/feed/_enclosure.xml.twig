{% if filename|default %}
            <enclosure url="{{ absolute_url(asset('/uploads/' ~ filename)) }}" length="0" type="{{ {jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', gif: 'image/gif', webp: 'image/webp', svg: 'image/svg+xml'}[filename|split('.')|last|lower]|default('application/octet-stream') }}"/>
{% endif %}
