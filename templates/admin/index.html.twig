{% extends 'base.html.twig' %}

{% block title %}Administration{% endblock %}

{% block body %}
    <div class="card border-secondary-subtle rounded-3">
        <div class="card-body px-4 pt-5 pb-3">
            <h1 class="fs-4 fw-semibold mb-3">Liste des utilisateurs</h1>

            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Identifiant</th>
                        <th>Rôles</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td>{{ user.id }}</td>
                            <td>{{ user.firstname|default() }} {{ user.lastname|default() }} &#60;{{ user.email }}&#62;</td>
                            <td>{{ ('user.role.' ~ user.highestRole|lower)|trans }}</td>
                            <td>
                                <a href="{{ path('admin_user_edit', { id: user.id }) }}" class="btn btn-sm btn-primary rounded-circle fw-semibold" title="Modifier">
                                    <i class="fa fa-pen"></i>
                                </a>
                                <form action="{{ path('admin_user_delete', { id: user.id }) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_user_delete') }}">
                                    <button type="submit" class="confirm-action btn btn-sm btn-outline-primary rounded-circle" data-confirm="Êtes-vous sûr ? Cette action est irréversible." title="Supprimer">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                                <form action="{{ path('admin_toggle_role', { id: user.id }) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_toggle_role') }}">
                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-circle" title="{% if 'ROLE_MODERATOR' in user.roles %}Retirer modérateur{% else %}Attribuer modérateur{% endif %}">
                                    {% if 'ROLE_MODERATOR' in user.roles %}
                                        <i class="fa fa-user-xmark"></i>
                                    {% else %}
                                        <i class="fa fa-user-shield"></i>
                                    {% endif %}
                                    </button>
                                </form>
                                <a href="{{ path('homepage', { '_switch_user': user.email }) }}" class="btn btn-sm btn-outline-primary rounded-circle" title="Se connecter en tant que">
                                    <i class="fa fa-address-card"></i>
                                </a>
                                <a href="javascript:void(0);" class="btn btn-sm btn-outline-primary rounded-circle" data-bs-toggle="modal" data-bs-target="#managePagesModal{{ user.id }}" title="Voir les pages association">
                                    <i class="fa fa-file-lines"></i>
                                </a>
                                <div class="modal fade" id="managePagesModal{{ user.id }}" tabindex="-1" aria-labelledby="managePagesModalLabel{{ user.id }}" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="managePagesModalLabel{{ user.id }}">List des pages association de {{ user.email }}</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                {% if user.chairedAssociations|default|length > 0 %}
                                                    <p>Associations présidées :</p>
                                                    <ul>
                                                        {% for chairedAssociation in user.chairedAssociations %}
                                                            <li>{{ chairedAssociation.name }}</li>
                                                        {% endfor %}
                                                    </ul>
                                                {% else %}
                                                    <p>Ne préside aucune association.</p>
                                                {% endif %}

                                                {% if user.memberships|default|length > 0 %}
                                                    <p>Membre des associations :</p>
                                                    <ul>
                                                        {% for membership in user.memberships %}
                                                            <li>{{ membership.association.name }}</li>
                                                        {% endfor %}
                                                    </ul>
                                                {% else %}
                                                    <p>N'est membre d'aucune association.</p>
                                                {% endif %}
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-primary rounded-pill" data-bs-dismiss="modal">J'ai compris</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <a href="{{ path('admin_user_new') }}" class="btn btn-primary rounded-pill fw-semibold mb-3">
                <i class="fa fa-user-plus"></i> Ajouter un utilisateur
            </a>
        </div>
    </div>
{% endblock %}
