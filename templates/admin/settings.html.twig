{% extends 'base.html.twig' %}

{% block title %}Paramètres généraux{% endblock %}

{% block body %}
    <div class="card border-secondary-subtle rounded-3">
        <div class="card-body px-4 pt-5 pb-3">
            <h1 class="fs-4 fw-semibold mb-3">Paramètres généraux</h1>

            {{ form_start(form) }}
                <table class="table table-bordered table-sm">
                    <thead>
                        <tr>
                            <th>Nom du paramètre</th>
                            <th>Valeur</th>
                            <th>Description</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="settings-collection">
                        {% for settingForm in form.settings %}
                            {% set readonly = not settingForm.vars.value.isEditable %}
                            <tr>
                                <td>{{ form_widget(settingForm['key'], {'attr': {'class': 'form-control', 'readonly': readonly ? 'true': false}}) }}</td>
                                <td>{{ form_widget(settingForm['value']) }}</td>
                                <td>{{ form_widget(settingForm['helpText'], {'attr': {'class': 'form-control', 'readonly': readonly ? 'true': false}}) }}</td>
                                <td class="text-center">
                                    {% if readonly == '' %}
                                        <button type="button" class="btn btn-sm btn-danger text-white remove-setting">
                                            <i class="fa fa-times"></i>
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                {% if form.settings.children|length == 0 %}
                    {% do form.settings.setRendered %}
                {% endif %}

                <div class="mt-4 pt-3 text-end">
                    <button type="button" class="btn btn-outline-primary rounded-pill me-3" id="add-setting" data-template="{{ include('admin/_setting_prototype.html.twig')|e('html') }}">
                        <i class="fa fa-circle-plus"></i>&nbsp;Ajouter un paramètre
                    </button>
                    <button class="btn btn-primary rounded-pill"><i class="fa fa-save"></i>&nbsp;Enregistrer les paramètres</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
