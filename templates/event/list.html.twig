{% extends 'base.html.twig' %}

{% block title %}{{ 'event.list.title'|trans }}{% endblock %}

{% block body %}
    <div class="card border-secondary-subtle rounded-3">
        <div class="card-body px-4 pt-5 pb-3">
            <div class="d-flex justify-content-between mb-3">
                <h1 class="fs-4 fw-semibold">{{ 'event.list.title'|trans }}</h1>

                <div class="flatpickr" data-single="{{ 'event.list.prefix.single'|trans }}" data-multiple="{{ 'event.list.prefix.multiple'|trans }}" data-locale="{{ app.request.locale|lower }}" data-default="{{ 'event.list.filter'|trans }}" data-toggle>
                    <button class="btn btn-sm btn-outline-primary rounded-pill with-calendar fs-6 px-3" data-input>
                        <small>{{ 'event.list.filter'|trans }}</small>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary border-0 rounded-circle ms-1 d-none" data-clear>
                        <i class="fa fa-refresh"></i>
                    </button>
                </div>
            </div>

            {% if events is not empty %}
                <div class="row">
                    {% for event in events %}
                        <div class="event-item col-6 d-flex p-3" data-from="{{ event.startAt|date('Y-m-d H:i:s') }}">
                            {% include 'event/show-with-image.html.twig' %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info">{{ 'home.events.none'|trans({'%days%': agendaNbDays}) }}</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
