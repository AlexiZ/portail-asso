<div class="card border-secondary-subtle px-3 py-4 rounded-3 mb-4">
    <div class="card-body">
        {% if title|default %}
            <div class="row mb-2">
                <h1 class="fs-4 fw-semibold">{{ title }}</h1>
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-6 col-sm-12">
                {{ form_row(formAssociation.name, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill mb-3', 'autocomplete': 'off'}}) }}

                {% if formAssociation.logo is defined %}
                    {{ form_row(formAssociation.logo, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill'}}) }}
                {% endif %}
            </div>

            {% if formAssociation.categories is defined %}
                <div class="col-md-6 col-sm-12">
                    {{ form_row(formAssociation.categories, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-select rounded-pill mb-3 js-tomselect'}}) }}

                    {% if association.logoFilename|default %}
                        <div class="w-100 my-auto">
                            <img src="/uploads/{{ association.logoFilename }}" alt="{{ association.name }}" class="img-fluid img-thumbnail border-0">
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-sm-12">
        {% if formAssociation.contacts is defined %}
            <div class="card border-secondary-subtle px-3 py-4 rounded-3 mb-4">
                <div class="card-body">
                    <h2 class="fs-5 fw-semibold">{{ 'association.form.contact.title'|trans }}</h2>
                    <h3 class="fs-6 fst-italic mb-3"><small>({{ 'association.form.optional'|trans }})</small></h3>
                    {% form_theme formAssociation.contacts 'association/contact_fields.html.twig' %}
                    <div id="contacts-collection" data-prototype="{{ form_widget(formAssociation.contacts.vars.prototype)|e('html_attr') }}">
                        {{ form_row(formAssociation.contacts) }}
                    </div>

                    <button type="button" class="btn btn-link text-primary ps-0 text-decoration-none" id="add-contact">
                        <i class="fa-solid fa-circle-plus"></i>&nbsp;{{ 'association.form.contact.add'|trans }}
                    </button>
                    {{ form_row(formAssociation.contactAddress, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill mb-3'}}) }}
                    {{ form_row(formAssociation.contactEmail, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill mb-3'}}) }}
                    {{ form_row(formAssociation.contactPhone, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill'}}) }}
                </div>
            </div>
        {% endif %}
    </div>

    <div class="col-md-6 col-sm-12">
        {% if formAssociation.networkWebsite is defined %}
            <div class="card border-secondary-subtle px-3 py-4 rounded-3 mb-4">
                <div class="card-body">
                    <h2 class="fs-5 fw-semibold">{{ 'association.form.network.title'|trans }}</h2>
                    <h3 class="fs-6 fst-italic mb-3"><small>({{ 'association.form.optional'|trans }})</small></h3>

                    {{ form_row(formAssociation.networkWebsite, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill mb-3'}}) }}
                    {{ form_row(formAssociation.networkFacebook, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill mb-3'}}) }}
                    {{ form_row(formAssociation.networkInstagram, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill mb-3'}}) }}
                    {{ form_row(formAssociation.networkOther, {'label_attr': {'class': 'my-2'}, 'attr': {'class': 'form-control rounded-pill'}}) }}
                </div>
            </div>
        {% endif %}
    </div>
</div>

{% if formAssociation.content is defined %}
    <div class="card border-secondary-subtle px-3 py-4 rounded-3">
        <div class="card-body">
            <h2 class="fs-5 fw-semibold mb-3">{{ 'association.form.content'|trans }}</h2>
            <p class="fs-6"><small>{{ 'association.form.content_help'|trans }}</small></p>
            {{ form_row(formAssociation.content, {'attr': {'class': 'form-control wysiwyg page-template'}}) }}
        </div>
    </div>
{% endif %}
