{% block contact_entry_widget %}
    <div class="contact-entry pe-4 position-relative">
        {{ form_row(form.name, {'label_attr': {'class': 'my-2'},'attr': {'class': 'form-control rounded-pill'}}) }}
        {{ form_row(form.function, {'label_attr': {'class': 'my-2'},'attr': {'class': 'form-control rounded-pill'}}) }}

        <span class="remove-contact py-2" title="{{ 'contact.form.remove'|trans }}"><i class="fa fa-times"></i></span>
    </div>
{% endblock %}
