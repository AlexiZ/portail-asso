{% extends 'base.html.twig' %}

{% block title %}{{ 'user_account.title'|trans }}{% endblock %}

{% block body %}
    <div class="row mb-4">
        <div class="col-md-6 col-sm-12">
            <div class="card border-secondary-subtle rounded-3">
                <div class="card-body px-4 pt-5 pb-3">
                    <h1 class="fs-4 fw-semibold mb-3">{{ 'user_account.title'|trans }}</h1>

                    <p><strong>{{ 'user_account.content.email'|trans }} :</strong> {{ user.email }}</p>
                    {% if app.user.highestRole != 'ROLE_USER' %}
                        <p><strong>{{ 'user_account.content.roles'|trans }} :</strong> {{ ('user.role.' ~ app.user.highestRole|lower)|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6 col-sm-12">
            <div class="card border-secondary-subtle rounded-3">
                <div class="card-body px-4 pt-5 pb-3">
                    <h2 class="fs-4 fw-semibold mb-3">{{ 'user_account.delete_account.title'|trans }}</h2>
                    <form class="my-4" method="post" onsubmit="return confirm('{{ 'user_account.delete_account.confirm'|trans }}');">
                        <input type="hidden" name="delete_account" value="1">
                        <div class="mb-3">
                            <button class="btn btn-outline-primary rounded-pill">
                                <i class="fa fa-triangle-exclamation"></i>&nbsp;{{ 'user_account.delete_account.submit'|trans }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4 card border-secondary-subtle rounded-3">
        <div class="card-body px-4 pt-5 pb-3">
            <h2 class="fs-4 fw-semibold mb-3">{{ 'user_account.edit.title'|trans }}</h2>
            {% include 'user/form.html.twig' %}
        </div>
    </div>
{% endblock %}
