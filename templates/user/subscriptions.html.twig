{% extends 'base.html.twig' %}

{% block title %}{{ 'user_subscriptions.title'|trans }}{% endblock %}

{% block body %}
    <div class="p-3 mb-4 bg-white rounded-3 border">
        <div class="container-fluid py-3">
            <h1 class="fw-bold">{{ 'user_subscriptions.title'|trans }}</h1>

            <p>
                {{ 'user_subscriptions.intro'|trans|raw }}
            </p>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchWeeklyReport" {% if weeklyReport|default %}checked{% endif %}>
                <label class="form-check-label" for="switchWeeklyReport">{{ 'user_subscriptions.cta'|trans|raw }}</label>
            </div>

            {% include 'association/_list.html.twig' with {'associations': associations, 'customEmptyMessage': 'user_subscriptions.empty_list'|trans} %}
        </div>
    </div>
{% endblock %}
