{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-7 mx-auto">
            <div class="card mt-5">
                <div class="card-body px-4 pt-5 pb-3">
                    <h1 class="fs-3 fw-semibold mb-4">{{ 'login.title'|trans }}</h1>

                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}

                    <form method="post">
                        <div class="mb-4">
                            <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control rounded-4" placeholder="{{ 'login.form.username'|trans }}" required autofocus>
                        </div>

                        <div class="mb-4">
                            <input type="password" name="_password" id="inputPassword" class="form-control rounded-4" placeholder="{{ 'login.form.password'|trans }}" required>
                        </div>

                        <div class="d-flex justify-content-between">
                            <button class="btn btn-primary rounded-pill fw-semibold" type="submit">
                                <i class="fa fa-arrow-right"></i>&nbsp;{{ 'login.form.submit'|trans }}
                            </button>

                            <a class="btn btn-outline-primary rounded-pill" href="{{ path('app_register') }}">
                                <i class="fa fa-user-pen"></i>&nbsp;{{ 'login.register'|trans }}
                            </a>
                        </div>
                    </form>

                    <p class="mt-3">
                        <a class="btn btn-link hover-text-primary text-black text-decoration-none p-0" href="{{ path('app_forgot_password') }}">
                            {{ 'login.form.forgotten_password'|trans }}
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
