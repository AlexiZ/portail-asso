{% extends 'base.html.twig' %}

{% block title %}{{ 'register.title'|trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-7 mx-auto">
            <div class="card border-secondary-subtle rounded-3">
                <div class="card-body px-4 pt-5 pb-3">
                    <h1 class="fs-4 fw-semibold mb-3">{{ 'register.title'|trans }}</h1>

                    {{ form_start(registrationForm) }}
                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="mb-4">
                                    {{ form_widget(registrationForm.firstname, {'attr': {'class':'form-control rounded-pill'}}) }}
                                    {{ form_errors(registrationForm.firstname) }}
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-6">
                                <div class="mb-4">
                                    {{ form_widget(registrationForm.lastname, {'attr': {'class':'form-control rounded-pill'}}) }}
                                    {{ form_errors(registrationForm.lastname) }}
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            {{ form_widget(registrationForm.email, {'attr': {'class':'form-control rounded-pill'}}) }}
                            {{ form_errors(registrationForm.email) }}
                        </div>

                        <div class="row">
                            <div class="col-sm-12 col-md-6">
                                <div class="mb-4">
                                    {{ form_widget(registrationForm.plainPassword.first, {'attr': {'class':'form-control rounded-pill'}}) }}
                                    {{ form_errors(registrationForm.plainPassword.first) }}
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-6">
                                <div class="mb-4">
                                    {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class':'form-control rounded-pill'}}) }}
                                    {{ form_errors(registrationForm.plainPassword.second) }}
                                </div>
                            </div>
                        </div>

                        {% if registrationForm.association is defined %}
                            <div class="d-none">
                                {{ form_row(registrationForm.association) }}
                            </div>
                        {% endif %}

                        <div class="py-3 d-flex justify-content-between">
                            <a class="btn btn-outline-primary rounded-pill" href="{{ path('app_login') }}">
                                {{ 'register.login'|trans }}
                            </a>

                            <button class="btn btn-primary rounded-pill" type="submit">
                                <i class="fa fa-user-plus"></i>&nbsp;{{ 'register.form.submit'|trans }}
                            </button>
                        </div>
                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
