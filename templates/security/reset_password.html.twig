{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.title'|trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-7 mx-auto">
            <div class="card border-secondary-subtle rounded-3">
                <div class="card-body px-4 pt-5 pb-3">
                    <h1 class="fs-4 fw-semibold mb-3">{{ 'reset_password.title'|trans }}</h1>

                    {{ form_start(resetPasswordForm) }}
                        <div class="mb-4">
                            {{ form_widget(resetPasswordForm.plainPassword.first, {'attr': {'class':'form-control rounded-pill'}}) }}
                            {{ form_errors(resetPasswordForm.plainPassword.first) }}
                        </div>
                        <div class="mb-4">
                            {{ form_widget(resetPasswordForm.plainPassword.second, {'attr': {'class':'form-control rounded-pill'}}) }}
                            {{ form_errors(resetPasswordForm.plainPassword.second) }}
                        </div>

                        <div class="py-3">
                            <button type="submit" class="btn btn-primary rounded-pill fw-semibold">{{ 'reset_password.submit'|trans }}</button>
                        </div>
                    {{ form_end(resetPasswordForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
